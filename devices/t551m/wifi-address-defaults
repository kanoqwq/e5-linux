#!/bin/sh
# The vendor driver leaves wiphy's permanent address zero. netifd otherwise
# gives hostapd an all-zero BSSID, while the firmware uses a different address.
# Keep one valid interface address in UCI; never replace an explicit user MAC.
case "$(cat /etc/e5/device-profile 2>/dev/null)" in t551m|e5|m8|t512n) ;; *) exit 0 ;; esac
. /lib/functions.sh
pending=0
seen=0
set_ap_address() {
    local section=$1 mode mac ifname phy address
    config_get mode "$section" mode
    [ "$mode" = ap ] || return 0
    seen=1
    config_get mac "$section" macaddr
    [ -z "$mac" ] || [ "$mac" = 00:00:00:00:00:00 ] || return 0
    config_get ifname "$section" ifname wlan0
    case "$ifname" in ''|*[!a-zA-Z0-9_.-]*) return 0 ;; esac
    phy=$(cat "/sys/class/net/$ifname/phy80211/macaddress" 2>/dev/null)
    [ "$phy" = 00:00:00:00:00:00 ] || { [ -n "$phy" ] || pending=1; return 0; }
    address=$(cat "/sys/class/net/$ifname/address" 2>/dev/null)
    # Six octets, unicast, nonzero. Only use a value actually exposed by driver.
    echo "$address" | grep -Eq '^[0-9a-f][02468ace](:[0-9a-f]{2}){5}$' &&
        [ "$address" != 00:00:00:00:00:00 ] || { pending=1; return 0; }
    uci set "wireless.$section.macaddr=$address" || { pending=1; return 0; }
    uci commit wireless || { pending=1; return 0; }
    logger -t wifi-address 'Saved a valid AP address for the wireless driver'
}
config_load wireless
config_foreach set_ap_address wifi-iface
# A delayed wireless probe may leave no generated AP section on first boot.
# Keep this migration until an AP actually exists and its address was checked.
[ "$seen" = 1 ] || pending=1
exit "$pending"
