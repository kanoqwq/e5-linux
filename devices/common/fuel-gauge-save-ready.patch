+static int sprd_fgu_read_saved_cap(struct sprd_fgu_info *info,
+		int (*read_cap)(struct sprd_fgu_info *, int *),
+		int expected, int *actual)
+{
+	int ret, timeout;
+
+	/* STATUS crosses the always-on RTC clock domain. E5 traces show a
+	 * transient cleared value even after SET/CLEAR completed. Recheck at
+	 * the existing 200us latch interval; stop as soon as it is committed.
+	 * The 2ms completion deadline bounds faulty hardware, not SOC itself.
+	 * Never reinterpret a valid zero or replace the requested capacity.
+	 */
+	timeout = read_poll_timeout(read_cap, ret, ret || *actual == expected,
+				  200, 2000, false, info, actual);
+	return ret ? ret : timeout;
+}
