# Board deltas on the existing UMS9620/M8 platform configuration.
CONFIG_LOCALVERSION="-yuanhang41s-bringup1"
CONFIG_SPI_SPRD=m
CONFIG_TOUCHSCREEN_ST7123=m
CONFIG_SND_SOC_AW883XX_FACTORY=m
# A 720x1600 32-bit frame exceeds the buddy allocator's normal maximum order.
# Reserve contiguous display DMA below 4 GiB, without changing the RAM map.
CONFIG_CMA=y
CONFIG_DMA_CMA=y
CONFIG_CMA_SIZE_MBYTES=64
# Consumers now own their clocks/regulators. Do not ship the early probe's
# blanket *_ignore_unused switches as a power-management policy.
CONFIG_CMDLINE="earlycon=sprd_serial,0x20210000,115200n8 console=ttyS1,115200n8 console=tty0 loglevel=7 log_buf_len=4M rdinit=/init panic=10 fw_devlink=permissive cma=64M@0-4G"
