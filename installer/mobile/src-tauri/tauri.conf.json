{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "OpenWrt Tools",
  "version": "1.0.0",
  "identifier": "cn.kanokano.openwrt.tools",
  "build": {
    "beforeDevCommand": "npm --prefix ../ui run dev",
    "beforeBuildCommand": "npm --prefix ../ui run build",
    "devUrl": "http://127.0.0.1:1420",
    "frontendDist": "../../ui/dist"
  },
  "app": {
    "windows": [{"label":"main","title":"OpenWrt Tools"}],
    "security": {"csp":"default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: https://api.kanokano.cn; connect-src 'self' ipc: http://ipc.localhost https://api.kanokano.cn"}
  },
  "bundle": {"active": true, "icon":["../../ui/src-tauri/icons/icon.png"], "android": {"minSdkVersion": 26}}
}
